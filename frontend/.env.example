# ── ANTIGRAVITY FRONTEND — ENVIRONMENT VARIABLES ────────────────────────────
# Copy this file to .env.local and fill in your values.

# Backend URL (Railway deployment URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Supabase Auth ──────────────────────────────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Razorpay Key ID (public — safe to expose in frontend)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
