[Unit]
Description=KEPLER FastAPI Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/kepler/backend
Environment=PATH=/home/ubuntu/kepler/backend/venv/bin
EnvironmentFile=/home/ubuntu/kepler/backend/.env
ExecStart=/home/ubuntu/kepler/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
