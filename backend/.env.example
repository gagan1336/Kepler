# ══════════════════════════════════════════════════════════════════════
# KEPLER BACKEND — Environment Variables
# Copy this file to .env and fill in all values before running.
# ══════════════════════════════════════════════════════════════════════

# ── AI ────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── DATABASE ──────────────────────────────────────────────────────────
# Railway PostgreSQL: from your Railway dashboard → Variables
# Supabase:          from Supabase → Settings → Database → Connection string
DATABASE_URL=postgresql://user:password@host:5432/kepler

# ── SUPABASE AUTH ─────────────────────────────────────────────────────
# Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here
# Supabase Dashboard → Settings → API → Project API keys → anon/public
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── NEWS APIs ─────────────────────────────────────────────────────────
# https://newsapi.org/register (free: 100 req/day)
NEWSAPI_KEY=your_newsapi_key_here
# https://gnews.io/ (free: 100 req/day)
GNEWS_API_KEY=your_gnews_api_key_here

# ── PAYMENTS ─────────────────────────────────────────────────────────
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Razorpay Dashboard → Webhooks → Create Webhook → Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── EMAIL (Resend) ────────────────────────────────────────────────────
# https://resend.com/api-keys (free: 3000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=digest@kepler.in
RESEND_FROM_NAME=KEPLER

# ── APP ───────────────────────────────────────────────────────────────
BACKEND_URL=https://your-app.railway.app
# Comma-separated allowed CORS origins
CORS_ORIGINS=https://kepler.in,https://www.kepler.in
ENVIRONMENT=production
# Email that can access admin-only endpoints (/admin/*, /signals/upload)
ADMIN_EMAIL=your_admin_email@gmail.com

# ── GOOGLE OAUTH (optional — for web dashboard) ───────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── LEGACY JWT (kept for backward compat — not used for new auth) ─────
SECRET_KEY=your_64_char_random_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── TELEGRAM (disabled — uncomment when ready) ────────────────────────
# TELEGRAM_BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_PRO_CHANNEL_ID=-1001234567890
# TELEGRAM_ELITE_CHANNEL_ID=-1001234567891
# ADMIN_TELEGRAM_ID=987654321
