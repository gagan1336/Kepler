# ─── ANTIGRAVITY BACKEND — ENVIRONMENT VARIABLES ───────────────────────────
# Copy this file to .env and fill in all values before running the backend.

# ── AI ──────────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── DATABASE ─────────────────────────────────────────────────────────────────
# Railway PostgreSQL URL — from your Railway dashboard
DATABASE_URL=postgresql://user:password@host.railway.app:5432/railway

# ── JWT AUTH ─────────────────────────────────────────────────────────────────
# Legacy secret key kept in case old tokens need to be decoded
SECRET_KEY=your_64_char_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── SUPABASE ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API → JWT Settings → JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# ── NEWS APIs ────────────────────────────────────────────────────────────────
# Get from: https://newsapi.org/register (free tier: 100 req/day)
NEWSAPI_KEY=your_newsapi_key_here

# Get from: https://gnews.io/ (free tier: 100 req/day)
GNEWS_API_KEY=your_gnews_api_key_here

# ── PAYMENTS ─────────────────────────────────────────────────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# From Razorpay Dashboard > Webhooks > Create Webhook > Secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── TELEGRAM ─────────────────────────────────────────────────────────────────
# Create bot at: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram channel IDs (prefix with -100 for private channels)
# Get IDs by adding @username_to_id_bot to your channels
TELEGRAM_PRO_CHANNEL_ID=-1001234567890
TELEGRAM_ELITE_CHANNEL_ID=-1001234567891

# Your personal Telegram user ID for admin alerts
# Get it from: https://t.me/userinfobot
ADMIN_TELEGRAM_ID=987654321

# ── EMAIL ────────────────────────────────────────────────────────────────────
# Get from: https://resend.com/api-keys (free tier: 3000 emails/month)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=digest@yourdomain.com
RESEND_FROM_NAME=Antigravity

# ── GOOGLE OAUTH ─────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── BACKEND ──────────────────────────────────────────────────────────────────
# Must match frontend NEXT_PUBLIC_API_URL
BACKEND_URL=https://your-app.railway.app

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,https://antigravity.vercel.app
