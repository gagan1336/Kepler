backend/.cache/

# ── PUSH TOKENS (now in DB — keeping for reference) ───────────────────────────
backend/push_tokens.json

# ── NODE / FRONTEND ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
.expo/

